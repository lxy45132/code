# 敏感项经环境变量或项目根 .env 注入（.env 不入 Git）；
# config.py 自动加载 .env，优先级：YAML < .env < 真实环境变量 < 显式 overrides。
# 键名规则：HYBRID_INPAINT__<SECTION>__<KEY>（双下划线分层，值按 JSON 解析）。
# 项目路径为 ASCII（D:\Code\bs\code），PYTHONUTF8 非必需。

# MySQL（storage.backend: mysql 时需要；本地单用户可用 root）
HYBRID_INPAINT__SYSTEM__STORAGE__MYSQL__USER=root
HYBRID_INPAINT__SYSTEM__STORAGE__MYSQL__PASSWORD=change-me

# 可选：公网部署预留的 API Key（非空时启用 X-API-Key 校验）
# HYBRID_INPAINT__SYSTEM__API__API_KEY=change-me

# 集成测试（默认 skip；指向独立测试库，测试会 drop_all 重建表）
# HYBRID_INPAINT_TEST_MYSQL_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/hybrid_inpaint_test
# HYBRID_INPAINT_TEST_REDIS_URL=redis://127.0.0.1:6379/15
